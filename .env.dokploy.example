# =============================================================================
# DeskcommCRM — Environment para deploy via Dokploy (service Compose).
# Cole o conteúdo preenchido no Environment do service no Dokploy, que grava
# como `.env` ao lado do docker-compose.dokploy.yml. O `env_file: .env` do
# app e do worker injeta tudo nos contêineres.
#
# Gere segredos numa máquina com openssl:
#   openssl rand -hex 32      (INTERNAL_SECRET, WAHA_API_KEY, WAHA_HMAC_SECRET, SRH_TOKEN, LGPD_SIGNING_KEY)
#   openssl rand -base64 32   (CPF_ENCRYPTION_KEY, AI_CRED_AES_KEY, WAHA_BYO_ENCRYPTION_KEY)
#   echo -n "<WAHA_API_KEY>" | sha512sum | awk '{print $1}'   (WAHA_API_KEY_SHA512)
# =============================================================================

# --- Domínio / Traefik do Dokploy --------------------------------------------
# OBRIGATÓRIO: alimenta as labels `Host()` do compose. Aponte o A-record para o IP do VPS.
DOMAIN=crm.seudominio.com.br
# Só mexa se o Traefik do seu Dokploy usa nomes fora do padrão.
TRAEFIK_NETWORK=dokploy-network
#TRAEFIK_ENTRYPOINT=websecure
#TRAEFIK_ENTRYPOINT_HTTP=web
#TRAEFIK_CERTRESOLVER=letsencrypt

# --- Imagens (mesma versão nas três; `:stable` = última release) --------------
APP_IMAGE=ghcr.io/melgarafael/deskcommcrm:stable
APP_PULL_POLICY=always
WORKER_IMAGE=ghcr.io/melgarafael/deskcomm-worker:stable
WORKER_PULL_POLICY=always
SCHEDULER_IMAGE=ghcr.io/melgarafael/deskcomm-scheduler:stable
SCHEDULER_PULL_POLICY=always

# --- Supabase (projeto criado no painel supabase.com → Settings → API/Database)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Connection string (Settings → Database) — a do APP (vai para os contêineres).
SUPABASE_DB_URL=
# Schema (baseline.sql) aplicado UMA VEZ por fora, antes do primeiro deploy
# (ver roteiro no chat): habilitar no Supabase as extensões vector, citext e
# pg_trgm, depois `psql "$SUPABASE_DB_URL" -f supabase/baseline.sql`.

# --- App URLs (runtime, sem rebuild: injetadas via PublicEnvScript) ------------
NEXT_PUBLIC_APP_URL=https://crm.seudominio.com.br
NEXT_PUBLIC_ADMIN_URL=https://crm.seudominio.com.br

# --- IA (opcionais: sem elas o CRM sobe e a chave entra depois pela tela) -----
AI_GATEWAY_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
#OPENROUTER_BASE_URL=
OPENAI_API_KEY=

# --- Segredos do app (gerar com openssl; NUNCA commitar preenchido) ------------
INTERNAL_SECRET=
#INTERNAL_CRON_SECRET=
CPF_ENCRYPTION_KEY=
AI_CRED_AES_KEY=
WAHA_BYO_ENCRYPTION_KEY=
IMPERSONATE_COOKIE_SECRET=
LGPD_SIGNING_KEY=

# --- WhatsApp / WAHA ----------------------------------------------------------
# Nome do serviço na rede docker (não mexer) + webhook interno (não mexer).
WAHA_API_BASE_URL=http://waha:3000
WAHA_WEBHOOK_BASE_URL=http://app:3000
WHATSAPP_RESTART_ALL_SESSIONS=True
# Plaintext que o app usa; o container recebe o hash (próxima linha).
WAHA_API_KEY=
# Hash SHA512 hex da linha acima (comando de geração no cabeçalho).
WAHA_API_KEY_SHA512=
# Assinatura dos webhooks (mesmo valor nos dois lados).
WAHA_HMAC_SECRET=

# --- Redis interno (srh; sem conta Upstash) ------------------------------------
UPSTASH_REDIS_REST_URL=http://srh:80
# = SRH_TOKEN abaixo (mesmo valor).
UPSTASH_REDIS_REST_TOKEN=
SRH_TOKEN=

# --- Flags --------------------------------------------------------------------
NODE_ENV=production
NUVEMSHOP_ENABLED=false
INTERNAL_AGENT_RUN_STUB=false
AGENT_DISPATCH_CONSUMER=engine

# --- E-mail transacional (Resend; opcional — sem ele o convite mostra link na UI)
# RESEND_FROM_EMAIL precisa ser de domínio VERIFICADO na sua conta Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Observabilidade (vazio = erros anonimizados ao Sentry da comunidade) ------
# SENTRY_DSN=off   → desliga toda a telemetria.
SENTRY_DSN=

# --- Bootstrap do 1º dono (lido pelo script, UMA VEZ, após o primeiro deploy) --
# Depois do deploy: abrir o terminal do service `worker` no Dokploy e rodar
#   pnpm exec tsx scripts/bootstrap-owner.ts
# (a imagem do worker carrega o repo + tsx e recebe este mesmo `.env`).
OWNER_EMAIL=voce@seudominio.com.br
OWNER_PASSWORD=
#APP_LOCALE=pt-BR

# --- Chamada de voz WhatsApp (DESLIGADA por padrão; risco de bloqueio da conta)
# Para ligar: COMPOSE_PROFILES=voz + WACALLS_API_BASE_URL=http://wacalls:8080
# (e aceitar o risco em Configurações › Segurança, na tela).
#COMPOSE_PROFILES=
#WACALLS_API_BASE_URL=
#WACALLS_ADMIN_USER=
#WACALLS_ADMIN_PASSWORD=
#WACALLS_API_TOKEN=
#WACALLS_PUBLIC_IP=
#WACALLS_WEBRTC_UDP_PORT=7881
